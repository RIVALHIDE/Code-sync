# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
build/
frontend/dist/
backend/dist/

# ── Environment variables (never commit secrets) ───────────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ── Database files (runtime data, not source) ─────────────────────────────────
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/coturn*

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Kiro agent internal files ─────────────────────────────────────────────────
__agent__/
frontend/test/
backend/test/

# ── Piston engine (local runtime, huge) ───────────────────────────────────────
piston/
